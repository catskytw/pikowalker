{
  "version": 8,
  "name": "PikoWalker Pikmin Style",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background-grass",
      "type": "background",
      "paint": {
        "background-color": "#7EC850"
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "grass", "scrub", "crop", "wood"],
      "paint": {
        "fill-color": "#65B83F",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "park", "forest", "recreation_ground", "pitch"],
      "paint": {
        "fill-color": "#5DB546",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "water-fill",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#7DC8E8",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "water-way",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#7DC8E8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 1, 19, 4]
      }
    },
    {
      "id": "building-fill",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#D0C89E",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "path", "footway", "cycleway", "pedestrian"],
      "paint": {
        "line-color": "#F3EACF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 1, 19, 4],
        "line-blur": 0.5
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "residential", "tertiary"],
      "paint": {
        "line-color": "#F3EACF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 2, 19, 8],
        "line-blur": 0.5
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary"],
      "paint": {
        "line-color": "#F3EACF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 3, 19, 10],
        "line-blur": 0.5
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "trunk", "motorway"],
      "paint": {
        "line-color": "#F3EACF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 5, 19, 16],
        "line-blur": 0.5
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "place-major",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "state", "city"],
      "minzoom": 4,
      "maxzoom": 13,
      "layout": {
        "text-field": ["coalesce", ["get", "name:zh"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 10, 15, 13, 18]
      },
      "paint": {
        "text-color": "#3C3C3C",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "town", "village"],
      "minzoom": 9,
      "maxzoom": 16,
      "layout": {
        "text-field": ["coalesce", ["get", "name:zh"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 10, 13, 13, 16, 15]
      },
      "paint": {
        "text-color": "#4A4A4A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.2
      }
    }
  ]
}
